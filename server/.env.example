# 複製本檔為 server/.env 後填入實際值。不要把 .env 提交到 git。

# ---- 資料庫 ----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=fma_yield
DB_DIALECT=mysql
DB_TIMEZONE=+08:00
DB_LOGGING=false

# 連線池
DB_POOL_MAX=20
DB_POOL_MIN=0
DB_POOL_ACQUIRE=30000
DB_POOL_IDLE=10000

# ---- 伺服器 ----
PORT=8080
NODE_ENV=development

# ---- 驗證 ----
# 至少 32 字元的隨機字串
JWT_SECRET=change_me_to_a_long_random_string_min_32_chars
JWT_EXPIRES_IN=24h
PASSPORT_SECRET=change_me_too

# ---- 選用：YOLO 推論服務（ml/）----
# 沒設就用內建 mock detector
DETECTOR_URL=
